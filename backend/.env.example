# Copy to backend/.env and supply values locally.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=
BUSINESS_SLUG=pearl-dental-care

# Gemini diagnostic settings (generation not yet verified).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare typed chat. Missing credentials trigger rule-based fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast


# Explicit frontend origins, separated by commas. No wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
